{
  "name": "zmt-media-player",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "electron": "electron electron/main.cjs",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:3000 && cross-env VITE_DEV_SERVER_URL=http://localhost:3000 electron electron/main.cjs\"",
    "electron:build": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win portable",
    "dist:installer": "npm run build && electron-builder --win nsis",
    "register:associations": "powershell -ExecutionPolicy Bypass -File scripts/register-associations.ps1",
    "unregister:associations": "powershell -ExecutionPolicy Bypass -File scripts/unregister-associations.ps1"
  },
  "build": {
    "appId": "com.zmt.mediaplayer",
    "productName": "Zmt Media Player",
    "electronDist": "node_modules/electron/dist",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "fileAssociations": [
      {
        "ext": "mp4",
        "name": "MP4 Video",
        "description": "MPEG-4 Video",
        "role": "Viewer"
      },
      {
        "ext": "mkv",
        "name": "Matroska Video",
        "description": "Matroska Video",
        "role": "Viewer"
      },
      {
        "ext": "webm",
        "name": "WebM Video",
        "description": "WebM Video",
        "role": "Viewer"
      },
      {
        "ext": "avi",
        "name": "AVI Video",
        "description": "Audio Video Interleave",
        "role": "Viewer"
      },
      {
        "ext": "mov",
        "name": "QuickTime Video",
        "description": "Apple QuickTime Movie",
        "role": "Viewer"
      },
      {
        "ext": "ts",
        "name": "MPEG-TS Video",
        "description": "MPEG Transport Stream",
        "role": "Viewer"
      },
      {
        "ext": "m4v",
        "name": "M4V Video",
        "description": "Apple iTunes Video",
        "role": "Viewer"
      },
      {
        "ext": "mp3",
        "name": "MP3 Audio",
        "description": "MPEG Audio Layer III",
        "role": "Viewer"
      },
      {
        "ext": "wav",
        "name": "WAV Audio",
        "description": "Waveform Audio File",
        "role": "Viewer"
      },
      {
        "ext": "flac",
        "name": "FLAC Audio",
        "description": "Free Lossless Audio Codec",
        "role": "Viewer"
      },
      {
        "ext": "ogg",
        "name": "OGG Audio",
        "description": "Ogg Vorbis Audio",
        "role": "Viewer"
      },
      {
        "ext": "m4a",
        "name": "M4A Audio",
        "description": "MPEG-4 Audio",
        "role": "Viewer"
      },
      {
        "ext": "aac",
        "name": "AAC Audio",
        "description": "Advanced Audio Coding",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        "dir",
        "portable"
      ],
      "forceCodeSigning": false
    }
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.2",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1"
  }
}
